# Base image for Airflow with Python 3.11
FROM apache/airflow:2.7.1-python3.11

# Switch to root to install system dependencies
USER root

# Install necessary dependencies including bash
RUN apt-get update && apt-get install -y --no-install-recommends \
    gcc \
    python3-dev \
    openjdk-11-jdk \
    procps && \
    apt-get clean && rm -rf /var/lib/apt/lists/*

# Set JAVA_HOME environment variable for Java runtime (dynamic architecture path)
ENV JAVA_HOME=/usr/lib/jvm/java-11-openjdk-amd64
ENV PATH=$JAVA_HOME/bin:$PATH

# (Optional) Set SPARK_HOME if needed for driver execution
# ENV SPARK_HOME=/opt/spark
# ENV PATH=$SPARK_HOME/bin:$PATH

# Switch back to the airflow user
USER airflow

# Install required Python packages with compatible versions
RUN pip install \
    apache-airflow-providers-apache-spark==4.11.3 \
    pyspark==3.4.1 \
    "apache-airflow-providers-openlineage>=1.8.0"
